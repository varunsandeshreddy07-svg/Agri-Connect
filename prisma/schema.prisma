generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  phone             String    @unique
  passwordHash      String
  name              String
  role              String    @default("farmer") // farmer | buyer
  avatar            String    @default("")
  organizationOrFarm String   @default("")
  location          String    @default("")
  verificationLevel String    @default("basic") // basic | land_verified | gold_certified
  verifiedKyc       Boolean   @default(false)
  verifiedLand      Boolean   @default(false)
  verifiedSoil      Boolean   @default(false)
  verifiedOrganic   Boolean   @default(false)
  memberSince       DateTime  @default(now())
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  listings           Listing[]
  sentMessages       Message[]      @relation("SentMessages")
  conversations      ConversationUser[]
  cropScans          CropScan[]
  notifications      Notification[]
  priceAlerts        PriceAlert[]
}

model Listing {
  id                  String   @id @default(cuid())
  farmerId            String
  title               String
  cropName            String
  variety             String   @default("")
  category            String   @default("Grains") // Grains, Pulses, Vegetables, Fruits, Spices, Oilseeds, Cash Crops
  quantity            Float
  unit                String   @default("quintals") // kg | quintals | tonnes
  pricePerUnit        Float
  mandiBenchmarkPrice Float   @default(0)
  minOrderQuantity    Float   @default(1)
  harvestDate         String   @default("")
  location            String   @default("")
  state               String   @default("")
  grade               String   @default("Grade A") // Grade A+ | Grade A | Grade B
  isOrganic           Boolean  @default(false)
  organicCertNumber   String   @default("")
  storageType         String   @default("Dry Ventilated Shed")
  moistureContent     Float    @default(12)
  description         String   @default("")
  status              String   @default("available") // available | reserved | sold
  tags                String   @default("[]") // JSON array stored as string
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  farmer              User     @relation(fields: [farmerId], references: [id])
  images              ListingImage[]
  tradeOffers         TradeOffer[]
}

model ListingImage {
  id        String  @id @default(cuid())
  listingId String
  imageUrl  String
  sortOrder Int     @default(0)

  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
}

model Conversation {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     ConversationUser[]
  messages  Message[]
}

model ConversationUser {
  id             String       @id @default(cuid())
  conversationId String
  userId         String
  unreadCount    Int          @default(0)

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id])

  @@unique([conversationId, userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  recipientId    String
  text           String
  offerJson      String       @default("") // JSON trade offer details
  read           Boolean      @default(false)
  createdAt      DateTime     @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation("SentMessages", fields: [senderId], references: [id])
}

model TradeOffer {
  id              String   @id @default(cuid())
  listingId       String
  buyerId         String
  farmerId        String
  proposedPrice   Float
  proposedQuantity Float
  unit            String
  totalAmount     Float
  status          String   @default("pending") // pending | accepted | declined | countered
  notes           String   @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  listing         Listing  @relation(fields: [listingId], references: [id])
}

model CropScan {
  id        String   @id @default(cuid())
  userId    String
  imageUrl  String
  resultJson String  // JSON result from AI
  cropName  String   @default("")
  score     Int      @default(0)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String   // message | offer | listing | system
  title     String
  message   String
  linkTo    String   @default("")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
}

model PriceAlert {
  id          String   @id @default(cuid())
  userId      String
  cropName    String
  targetPrice Float
  direction   String   @default("above") // above | below
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id])
}

model MarketPrice {
  id            String   @id @default(cuid())
  crop          String
  market        String
  mandiPrice    Float
  directPrice   Float
  change        String
  trend         String   @default("stable") // up | down | stable
  unit          String   @default("₹/qtl")
  fetchedAt     DateTime @default(now())
}
